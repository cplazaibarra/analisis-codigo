[Unit]
Description=SCAN-CODE Central Security Scanner Portal (Global)
After=network.target

[Service]
Type=simple
User=cplaza
WorkingDirectory=/home/cplaza/Desarrollo/central-scanner
ExecStart=/home/cplaza/Desarrollo/central-scanner/venv/bin/python app.py
Restart=always
RestartSec=5
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
